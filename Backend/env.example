# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration*
MONGODB_URI=


# JWT Configuration
JWT_SECRET=your-sut-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refreshcret-change-this-in-production
JWT_REFRESH_EXPIRE=30d


# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173


# Realtime & Queue Configuration
# Redis Configuration - Set REDIS_ENABLED=true to use Redis caching
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
TOKEN_QUEUE_DEFAULT_AVG_MINUTES=15
TOKEN_QUEUE_MAX_RECALLS=2
QUEUE_RECALC_CRON=*/5 * * * *
QUEUE_NOSHOW_CRON=*/10 * * * *

# Project assignment engine — platform vendor used when a freelancer wins the pool (VendorOpsProject owner)
FREELANCER_POOL_VENDOR_ID=
# Every 5 min: re-run vendor / freelancer-pool timeouts the queue missed, start vendor
# matching for paid requests that never reached it, and retry failed escrow refunds.
# On by default; set to false on machines pointed at a shared database.
ASSIGNMENT_RECOVERY_SWEEP_ENABLED=true

# Rate limiting (Redis-backed when REDIS_ENABLED=true — required for PM2 cluster)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Soft cap for authenticated engineer list/dashboard/job GETs (per IP)
ENGINEER_API_RATE_WINDOW_MS=60000
ENGINEER_API_RATE_MAX=120

# HTTP server timeouts (ms) — keepAlive > ALB idle timeout (typically 60s)
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=120000

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# Email (transactional mail for every panel — services/mail/mailer.js)
# Required to send. With Gmail / Google Workspace use an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=
# Sender shown to recipients. Gmail only allows the login mailbox or a
# verified "Send mail as" alias here.
EMAIL_FROM="WBI <noreply@example.com>"
# Optional
# EMAIL_REPLY_TO=support@example.com
# EMAIL_SECURE=true                      # implicit TLS (auto when EMAIL_PORT=465)
# EMAIL_TLS_REJECT_UNAUTHORIZED=false    # only for a relay with a private certificate
# EMAIL_DISABLED=true                    # stop all outgoing mail (logged instead)
# EMAIL_MAX_CONNECTIONS=5
APP_NAME=WBI
# Public web app URL used in email links (defaults to the first FRONTEND_URL)
APP_PUBLIC_URL=https://app.example.com
SUPPORT_EMAIL=support@example.com
# Ops inbox for admin alerts (new registrations, reviews, SLA breaches).
# When unset, alerts go to every active admin's own email.
# ADMIN_NOTIFICATION_EMAILS=ops@example.com,admin@example.com


# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=

# Admin registration safeguard
ADMIN_REGISTRATION_CODE=secure-code-to-create-admins


# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# REQUIRED in production for joining-fee + booking recovery when client verify fails
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Unified payments webhook (raw body): https://<host>/api/webhooks/razorpay/payments
# Subscribe: payment.captured, payment.failed, refund.processed
# Optional AES key for encrypting saved Razorpay token ids at rest (64-char hex or passphrase)
# PAYMENT_TOKEN_ENCRYPTION_KEY=
# Set false only in local dev to skip OTP on delete/default payment method
# PAYMENT_SENSITIVE_OTP=true
# Dynamic service request (user form → vendor queue): set true only for local dev without Razorpay
# When false and keys are set, user must pay FormSchema basePrice via Razorpay before vendors see the request
SERVICE_REQUEST_SKIP_PAYMENT=false
# Dashboard webhook URL (raw body): https://app.wbinfs.com/api/engineer/joining-fee/webhook
# Subscribe events: payment.captured, payment.failed, order.paid

# B2B matching waves (km) and timeouts
B2B_MATCH_WAVE_RADII=5,10,20,50,100
B2B_MATCH_WAVE_TIMEOUT_MS=30000
B2B_MATCH_PER_WAVE_LIMIT=10
B2B_SPARE_PARTS_VISIT_FEE=250
B2B_CLIENT_DEPENDENCY_PENALTY=250

# Password reset configuration
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173


FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

FIREBASE_CONFIG=





# ========================================
# CGPE / GSP VERIFICATION (GST, PAN, Aadhaar)
# ========================================
# Never ship real keys in source — set these in production secrets only.
# Never put CGPE credentials on the frontend.
CGPE_BASE_URL=https://verify.cgpey.com
CGPE_API_KEY=
CGPE_CLIENT_ID=
CGPE_CLIENT_SECRET=
# Alias env names (optional)
# VERIFY_API_BASE_URL=
# VERIFY_API_KEY=
# VERIFY_MERCHANT_ID=
# VERIFY_SECRET_KEY=
# USE_MOCK_KYC=true only for local offline testing (never production)
USE_MOCK_KYC=false
# GST_VERIFY_CACHE=true
# GST_VERIFY_CACHE_TTL_SEC=3600
# GST_VERIFY_MAX_RETRIES=2
# GST_VERIFY_RETRY_BASE_MS=400
# GST_VERIFY_RATE_LIMIT_MAX=10
# GST_VERIFY_MAX_AGE_HOURS=72
# GST_ALLOW_DUPLICATE=false
# GST_REQUIRE_ACTIVE_STATUS=true
# CIN / MCA verification
# CIN_VERIFY_CACHE=true
# CIN_VERIFY_CACHE_TTL_SEC=3600
# CIN_VERIFY_MAX_RETRIES=2
# CIN_VERIFY_RETRY_BASE_MS=400
# CIN_VERIFY_RATE_LIMIT_MAX=10
# CIN_VERIFY_MAX_AGE_HOURS=72
# CIN_ALLOW_DUPLICATE=false
# CIN_REQUIRE_ACTIVE_STATUS=true
# CIN_REQUIRE_B2B=false
# UPI / Mobile-UPI / Location suite
# CGPE_SUITE_RATE_LIMIT_MAX=20
# UPI_VERIFY_CACHE=true
# UPI_VERIFY_CACHE_TTL_SEC=3600
# UPI_VERIFY_MAX_RETRIES=2
# UPI_VERIFY_MAX_AGE_HOURS=720
# UPI_REQUIRE_NAME=false
# UPI_REQUIRE_FOR_WITHDRAWAL=true
# LOC_VERIFY_CACHE=true
# LOC_VERIFY_CACHE_TTL_SEC=86400
# LOC_VERIFY_MAX_RETRIES=2

# ========================================
# SMS INDIA HUB CONFIGURATION
# ========================================
# Get these from your SMS India Hub account
SMS_INDIA_HUB_USERNAME=

SMS_INDIA_HUB_API_KEY=

# Default sender (WBINFS). All OTP SMS use SMS_INDIA_HUB_DLT_TEMPLATE_ID_TASKY + TaskY DLT body in smsService.
SMS_INDIA_HUB_SENDER_ID=WBINFS
# SMS_INDIA_HUB_SENDER_ID_LEGACY=BGADEC
# Engineer/worker registration (DLT template 1077311990016977854) — use WBINFS
# SMS_INDIA_HUB_SENDER_ID_TASKY=WBINFS

# DLT Principal Entity ID (if SMS India Hub rejects API messages without entityid)
# SMS_INDIA_HUB_DLT_ENTITY_ID=

# Default DLT template id (optional fallback; platform OTP uses TASKY id below)
SMS_INDIA_HUB_DLT_TEMPLATE_ID=

# DLT template for all OTP SMS (user + engineer + worker + vendor) — id 1077311990016977854
SMS_INDIA_HUB_DLT_TEMPLATE_ID_TASKY=1077311990016977854
# ========================================
# OTP CONFIGURATION (PRODUCTION VALUES)
# ========================================
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600
# Set to 'true' to use default OTP (123456) for testing (development only — ignored in production)
# Must be 'false' (or unset) in production
USE_DEFAULT_OTP=false 
# Set true ONLY to keep built-in QA phones (9999999999 / 8888888888) accepting the bypass OTP in production. Leave unset/false.
# ALLOW_BUILTIN_QA_OTP_IN_PROD=false
# Password for scripts/seedB2BTestFleet.js (required; no default)
# QA_FLEET_PASSWORD=
