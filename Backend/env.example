# VERIFY_API_BASE_URL=
# VERIFY_API_KEY=
# VERIFY_MERCHANT_ID=
# VERIFY_SECRET_KEY=
# USE_MOCK_KYC=true only for local offline testing (never production)
USE_MOCK_KYC=false
