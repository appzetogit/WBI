# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration*
MONGODB_URI=


# JWT Configuration
JWT_SECRET=your-sut-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refreshcret-change-this-in-production
JWT_REFRESH_EXPIRE=30d


# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173


# Realtime & Queue Configuration
# Redis Configuration - Set REDIS_ENABLED=true to use Redis caching
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
TOKEN_QUEUE_DEFAULT_AVG_MINUTES=15
TOKEN_QUEUE_MAX_RECALLS=2
QUEUE_RECALC_CRON=*/5 * * * *
QUEUE_NOSHOW_CRON=*/10 * * * *

# Project assignment engine — platform vendor used when a freelancer wins the pool (VendorOpsProject owner)
FREELANCER_POOL_VENDOR_ID=

# Rate limiting (Redis-backed when REDIS_ENABLED=true — required for PM2 cluster)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Soft cap for authenticated engineer list/dashboard/job GETs (per IP)
ENGINEER_API_RATE_WINDOW_MS=60000
ENGINEER_API_RATE_MAX=120

# HTTP server timeouts (ms) — keepAlive > ALB idle timeout (typically 60s)
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=120000

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=h
CLOUDINARY_API_KEY=638952
CLOUDINARY_API_SECRET=bYvT1fWtM


# Email Configuration (if using email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=homecareofficialsolution@gmail.com
EMAIL_PASS=
EMAIL_FROM="Appzeto <noreply@Wbi.com>"


# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=

# Admin registration safeguard
ADMIN_REGISTRATION_CODE=secure-code-to-create-admins
ADMIN_NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com


# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# REQUIRED in production for joining-fee + booking recovery when client verify fails
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# Unified payments webhook (raw body): https://<host>/api/webhooks/razorpay/payments
# Subscribe: payment.captured, payment.failed, refund.processed
# Optional AES key for encrypting saved Razorpay token ids at rest (64-char hex or passphrase)
# PAYMENT_TOKEN_ENCRYPTION_KEY=
# Set false only in local dev to skip OTP on delete/default payment method
# PAYMENT_SENSITIVE_OTP=true
# Dynamic service request (user form → vendor queue): set true only for local dev without Razorpay
# When false and keys are set, user must pay FormSchema basePrice via Razorpay before vendors see the request
SERVICE_REQUEST_SKIP_PAYMENT=false
# Dashboard webhook URL (raw body): https://app.wbinfs.com/api/engineer/joining-fee/webhook
# Subscribe events: payment.captured, payment.failed, order.paid

# B2B matching waves (km) and timeouts
B2B_MATCH_WAVE_RADII=5,10,20,50,100
B2B_MATCH_WAVE_TIMEOUT_MS=30000
B2B_MATCH_PER_WAVE_LIMIT=10
B2B_SPARE_PARTS_VISIT_FEE=250
B2B_CLIENT_DEPENDENCY_PENALTY=250

# Password reset configuration
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Socket.io Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173


FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

