# ========================================
# SMS INDIA HUB CONFIGURATION
# ========================================
# Get these from your SMS India Hub account
SMS_INDIA_HUB_USERNAME=

SMS_INDIA_HUB_API_KEY=

# Default sender (WBINFS). All OTP SMS use SMS_INDIA_HUB_DLT_TEMPLATE_ID_TASKY + TaskY DLT body in smsService.
SMS_INDIA_HUB_SENDER_ID=WBINFS
# SMS_INDIA_HUB_SENDER_ID_LEGACY=BGADEC
# Engineer/worker registration (DLT template 1077311990016977854) — use WBINFS
# SMS_INDIA_HUB_SENDER_ID_TASKY=WBINFS

# DLT Principal Entity ID (if SMS India Hub rejects API messages without entityid)
# SMS_INDIA_HUB_DLT_ENTITY_ID=

# Default DLT template id (optional fallback; platform OTP uses TASKY id below)
SMS_INDIA_HUB_DLT_TEMPLATE_ID=

# DLT template for all OTP SMS (user + engineer + worker + vendor) — id 1077311990016977854
SMS_INDIA_HUB_DLT_TEMPLATE_ID_TASKY=1077311990016977854
# ========================================
# OTP CONFIGURATION (PRODUCTION VALUES)
# ========================================
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600
# Set to 'true' to use default OTP (123456) for testing (development only — ignored in production)
# Must be 'false' (or unset) in production
USE_DEFAULT_OTP=false 